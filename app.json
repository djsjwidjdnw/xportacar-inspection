{
  "expo": {
    "name": "XportACar Inspector",
    "slug": "xportacar-inspection",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/aa330a36-df38-452f-9cb8-4c02c780701f",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1570EF"
    },
    "scheme": "xportacar-inspector",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xportacar.inspector",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "XportACar needs camera access to capture vehicle photos during inspection.",
        "NSPhotoLibraryUsageDescription": "XportACar saves inspection photos to your library."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1570EF"
      },
      "package": "com.xportacar.inspector",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow XportACar to access your camera to document vehicle inspections."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow XportACar to access photos for vehicle inspections.",
          "cameraPermission": "Allow XportACar to access the camera for vehicle inspections."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://klettmjnnttajdyajafn.supabase.co",
      "supabaseAnonKey": "sb_publishable_rawIwWZv12q9_VxVuaMOWQ_A2oXTEJ_",
      "eas": {
        "projectId": "aa330a36-df38-452f-9cb8-4c02c780701f"
      }
    },
    "owner": "chasebitz"
  }
}
